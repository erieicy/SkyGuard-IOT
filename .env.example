# ============================================================
# SkyGuard AI - Template Konfigurasi API AI Vision
# ============================================================
# Salin file ini menjadi .env dan isi nilai berikut.
#
# Provider yang didukung: gemini  atau  openai
#
# Untuk Google Gemini:
#   AI_PROVIDER = gemini
#   AI_API_KEY  = AIzaSy.... (Google AI Studio key)
#   AI_MODEL    = gemini-1.5-flash
#
# Untuk OpenAI:
#   AI_PROVIDER = openai
#   AI_API_KEY  = sk-.... (OpenAI API key)
#   AI_MODEL    = gpt-4o-mini
# ============================================================

AI_PROVIDER=gemini
AI_API_KEY=YOUR_API_KEY_HERE
AI_MODEL=gemini-1.5-flash
